@model HomeTextModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<form method="post" asp-action="SetNieuweText" asp-controller="Home">
    <div class="row">
        <label asp-for="HomeText.Id" class="col-form-label">Id</label>
        <input type="number" name="Id" value="@Model.HomeText.Id" readonly />
    </div>
    <div class="row">
        <label asp-for="HomeText.Subject" class="col-form-label">Onderwerp</label>
        <input asp-for="HomeText.Subject" type="text" value="@Model.HomeText.Subject" minlengt="1" />
        <span asp-validationfor="HomeText.Subject"></span>
    </div>
    <div class="row">
        <label asp-for="HomeText.Body" class="col-form-label">Inhoud</label>
        <textarea asp-for="HomeText.Body" rows="10"></textarea>
        
    </div>
    <div>
       <label asp-for="HomeText.IsActive" class="col-form-label">Geactiveerd</label>
        <input type="checkbox" asp-for="HomeText.IsActive" class="col-form-label" />        
    </div>
    <input id="btnChange" type="submit" value="Aanpassen" class="btn btn-outline-primary" />
    <span asp-validationfor="HomeText"></span>
</form>