@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.Localization
@using Home_Central.Resources
@using Microsoft.AspNetCore.Localization
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject IHtmlLocalizer<SharedResource> SharedLocalizer
@inject IViewLocalizer Localizer
@model IEnumerable<HomeCentral.Data.Entities.Linken>
@{
    ViewData["Title"] = "Linken";
}


<div>  
    @if (Model != null)
    {
        <table class="table-borderless">
        @foreach (var text in Model)
        {
            <tr class="d-lg-table-row">            
                <td class="col col-1" hidden>@text.Id</td>
                <td class="col col-3"><a href="@text.Url" target="_blank">@text.Name</a></td>
                <td class="col col-3">@text.Active</td>                 
            <td>
                @if (SignInManager.IsSignedIn(User))
            {
                <button type="submit" onclick="location='@Url.Action("Edit", "Linken", @text)'" class="btn btn-outline-primary">Tekst blok aanpassen</button>
                <button type="submit" onclick="location='@Url.Action("Delete", "Linken", new { id = text.Id }) '" class="btn btn-outline-primary">Delete blok</button>
            }
            </td>
            
            </tr>
        }
        </table>
    }
    <button type="submit" onclick="location='@Url.Action("Create", "Linken")'" class="btn btn-outline-primary">Link invoegen</button>
</div>

@if (SignInManager.IsSignedIn(User))
{
    
}
